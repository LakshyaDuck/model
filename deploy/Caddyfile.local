{
	# This file is for local HTTP development. The production Caddyfile should use
	# a real hostname and TLS, but preserve these routing and isolation rules.
	auto_https off
}

:80 {
	@private path /internal/* /metrics*
	respond @private 404

	# Do not add request buffering here: tus PATCH bodies must stream to tusd so
	# interrupted phone uploads remain resumable.
	handle /files/* {
		reverse_proxy tusd:1080 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Phone pairing URLs are frontend routes: PUBLIC_BASE_URL/m/<pair-token> must
	# reach the React scanner, and /phone/<pair-token> is the compatibility alias.
	# The backend dev page at /m/<token> stays available on the direct API port.

	handle /healthz {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}

