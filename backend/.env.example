# Copy this file to .env and fill it in. NEVER commit .env.
# The API and tusd read the same values; docker-compose interpolates this file.
#
# Only HOOK_SECRET is a secret. Everything else is config and may live in the
# compose file or a shared .env. Generate the secret with:  openssl rand -hex 24

# Public origin users actually visit. No trailing slash. Used to build the QR URL.
PUBLIC_BASE_URL=https://capture.example.org

# Shared volume. Must be the SAME path in the API and tusd containers.
# DATA_DIR/tus and DATA_DIR/sessions must be on one filesystem (post-finish renames).
DATA_DIR=/data

# SECRET. Shared with tusd via the hook URL. 16+ chars, URL-safe (A-Z a-z 0-9 . _ ~ -).
# HOOK_SECRET is placed in the tusd hook URL, so do NOT use a base64 value (its "+"
# is decoded as a space in the query and every hook 401s). Render's Blueprint
# generateValue mints base64, so generate your own instead:
#   openssl rand -hex 24
HOOK_SECRET=

# Optional (defaults shown).
PAIR_TOKEN_TTL_MIN=30
MAX_UPLOAD_BYTES=5368709120
MAX_ASSETS_PER_SESSION=200
# Comma-separated. Defaults to the origin of PUBLIC_BASE_URL.
CORS_ORIGINS=
