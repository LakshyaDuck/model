# Copy this file to .env (same directory) and fill it in. NEVER commit .env.
#
# The backend reads this file automatically at startup. Variables already set in
# the operating system or deployment environment override the values here, so the
# Docker/PaaS configuration keeps working unchanged.
#
# Only HOOK_SECRET is a secret. Generate it, do not reuse an example:
#   PowerShell:  uv run python -c "import secrets; print(secrets.token_hex(24))"
#   bash:        openssl rand -hex 24

# Public origin users actually visit. No trailing slash. Used to build the QR URL
# (PUBLIC_BASE_URL/m/<pair-token>), which is a frontend route.
# The phone must be able to open this origin, so use the laptop's LAN IPv4 and the
# port that serves the React app:
#   Docker stack:  PUBLIC_BASE_URL=http://192.168.1.20:8080
#   Vite dev:      PUBLIC_BASE_URL=http://192.168.1.20:5173
# Do not point this at the API port: the API no longer serves the phone scanner.
# localhost only works when the phone is on the laptop itself or through a tunnel.
PUBLIC_BASE_URL=http://localhost:5173

# Where uploads and session data live.
# Local development: relative paths resolve from the directory uvicorn runs in
# (run the command from backend/, so ./data means backend/data).
# Production/Docker: use an absolute path such as /data.
DATA_DIR=./data

# SECRET. Shared with tusd via the hook URL. 16+ chars, URL-safe (A-Z a-z 0-9 . _ ~ -).
# HOOK_SECRET is placed in the tusd hook URL, so do NOT use a base64 value (its "+"
# is decoded as a space in the query and every hook 401s). Render's Blueprint
# generateValue mints base64, so generate your own instead.
# This MUST be filled in; an empty value stops startup with a clear error.
HOOK_SECRET=

# Optional (defaults shown).
PAIR_TOKEN_TTL_MIN=30
MAX_UPLOAD_BYTES=5368709120
MAX_ASSETS_PER_SESSION=200
# Comma-separated. Defaults to the origin of PUBLIC_BASE_URL.
CORS_ORIGINS=
