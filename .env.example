# Copy to .env before starting the local Docker stack.
# Use your laptop's LAN address (for example http://192.168.1.20:8080) when a
# phone must scan the QR code. localhost only works on the laptop itself.
PUBLIC_BASE_URL=http://localhost:8080

# This value is deliberately suitable only for local development. Generate a
# unique value before any shared deployment: openssl rand -hex 24
HOOK_SECRET=dev-only-change-before-any-shared-deployment-0123456789

PAIR_TOKEN_TTL_MIN=30
MAX_UPLOAD_BYTES=5368709120
MAX_ASSETS_PER_SESSION=200
CORS_ORIGINS=

# Keep this configurable until a tested image digest is recorded for the target
# architecture. Docker pulls it automatically on the first `compose run`.
COLMAP_IMAGE=colmap/colmap:latest

